<%- include('../partials/header', { title }) %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1 class="h2 mb-0"><%= title %></h1>
      <a class="btn btn-outline-secondary" href="/productos">Volver</a>
    </div>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form class="card border-0 shadow-sm" method="post" action="<%= action %>">
      <div class="card-body p-4">
        <div class="mb-3">
          <label class="form-label" for="nombre">Nombre</label>
          <input class="form-control" id="nombre" name="nombre" maxlength="150" required
                 value="<%= producto?.nombre ?? '' %>">
        </div>
        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label" for="precio">Precio</label>
            <input class="form-control" id="precio" name="precio" type="number" min="0" step="0.01" required
                   value="<%= producto?.precio ?? '' %>">
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label" for="stock">Stock</label>
            <input class="form-control" id="stock" name="stock" type="number" min="0" step="1" required
                   value="<%= producto?.stock ?? 0 %>">
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label" for="categorias">Categorías</label>
          <select class="form-select" id="categorias" name="categorias" multiple size="6">
            <% categorias.forEach((categoria) => { %>
              <option value="<%= categoria.id %>" <%= selectedCategoryIds.includes(categoria.id) ? 'selected' : '' %>>
                <%= categoria.nombre %>
              </option>
            <% }) %>
          </select>
          <div class="form-text">Usa Ctrl (Windows/Linux) o Cmd (macOS) para seleccionar varias.</div>
          <% if (categorias.length === 0) { %>
            <div class="form-text text-warning">No hay categorías. Puedes crearlas desde la sección Categorías.</div>
          <% } %>
        </div>
      </div>
      <div class="card-footer bg-white border-0 px-4 pb-4">
        <button class="btn btn-primary" type="submit"><%= submitLabel %></button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
